# Set one provider key, or an OpenRouter key to route all models through OpenRouter.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional provider pricing overrides, USD per 1,000,000 tokens.
# Leave blank to use provider-reported costs when available or mark estimates unavailable.
INPUT_PRICE_USD_PER_MILLION=
OUTPUT_PRICE_USD_PER_MILLION=

# Optional provider base URLs.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENAI_BASE_URL=https://api.openai.com/v1
